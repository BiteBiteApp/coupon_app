rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function deletionActorMayWrite() {
      return signedIn() && !firestore.exists(/databases/(default)/documents/private_account_deletions/$(request.auth.uid));
    }

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAllowedImage() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isSharedMenuOwner(menuId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/restaurant_menus/$(menuId))
        && firestore.get(/databases/(default)/documents/restaurant_menus/$(menuId)).data.createdByUserId == request.auth.uid;
    }

    function dishExists(dishId) {
      return firestore.exists(/databases/(default)/documents/bitescore_dishes/$(dishId));
    }

    match /bitesaver_restaurants/{uid}/restaurant_images/{fileName} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /bitesaver_restaurants/{uid}/coupon_images/{fileName} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /bitesaver_restaurants/{uid}/menu_images/{fileName} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /restaurant_menus/{menuId}/menu_images/{fileName} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /bitescore_dishes/{dishId}/images/{fileName} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if false;
    }

    match /bitescore_user_uploads/{ownerKey}/dish_images/{dishId}/{fileName} {
      allow read: if true;
      // Exactly two Firestore documents: actor fence and existing dish.
      allow create: if resource == null && deletionActorMayWrite() && ownerKey == hashing.sha256('bitestar.dish-upload.v1:' + request.auth.uid).toHexString().lower() && dishExists(dishId) && isAllowedImage()
        && request.resource.metadata.keys().hasOnly(['ownershipVersion', 'uploaderKey', 'dishId'])
        && request.resource.metadata.ownershipVersion == '1'
        && request.resource.metadata.uploaderKey == ownerKey
        && request.resource.metadata.dishId == dishId;
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
