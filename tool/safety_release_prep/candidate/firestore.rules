rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Nonexecuting safety release candidate, derived from the recorded live baseline.
    // Existing unrelated content/search holds remain in force.
    function createsEmptySharedMenu() {
      let data = request.resource.data;
      let restaurant = get(/databases/$(database)/documents/bitescore_restaurants/$(data.bitescoreRestaurantId)).data;
      return data.keys().hasOnly(['restaurantName', 'normalizedName', 'normalizedAddressKey', 'bitescoreRestaurantId', 'createdByUserId', 'linkStatus', 'createdAt', 'updatedAt']) &&
        data.restaurantName == restaurant.name.trim() && data.linkStatus == 'bitescore_only';
    }

    function customerPostingAllowed() {
      let path = /databases/$(database)/documents/user_profiles/$(request.auth.uid)/posting_restriction_state/current;
      let restriction = get(path);
      return signedIn() && (restriction == null || postingRestrictionInactive(restriction.data));
    }

    function customerTermsAccepted() {
      return !customerTermsRequired() || (emailVerified() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' && currentTermsReceipt(request.auth.uid));
    }

    function currentTermsReceipt(userId) {
      let policy = get(/databases/$(database)/documents/private_bitescore_runtime/terms).data;
      let receipt = get(/databases/$(database)/documents/user_profiles/$(userId)).data.get('termsAcceptance', {});
      return policy.get('schemaVersion', null) == 1 && policy.get('required', false) == true &&
        policy.get('version', null) is string && policy.version.trim().size() > 0 &&
        policy.get('acceptedVersions', null) is list && policy.version in policy.acceptedVersions &&
        receipt.get('version', null) is string && receipt.version.size() > 0 && receipt.version in policy.acceptedVersions &&
        receipt.get('acceptedAt', null) is timestamp && receipt.acceptedAt <= request.time;
    }

    function customerTermsRequired() {
      let path = /databases/$(database)/documents/private_bitescore_runtime/terms;
      let runtime = get(path);
      return runtime != null && runtime.data.get('required', null) != false;
    }

    function deletionCatalogAttributionMayWrite() {
      return deletionCatalogFieldMayWrite('ownerUserId') && deletionCatalogFieldMayWrite('createdByUserId');
    }

    function deletionCatalogFieldMayWrite(field) {
      return (resource != null && request.resource.data.get(field, null) == resource.data.get(field, null)) ||
        deletionOptionalIdentityMayWrite(request.resource.data, field);
    }

    function initializesEmptySharedMenuLink(restaurantId) {
      return changedKeys().hasOnly(['sharedMenuId', 'restaurantWriteRevision', 'updatedAt']) &&
        resource.data.get('sharedMenuId', null) in [null, ''] &&
        !exists(/databases/$(database)/documents/restaurant_menus/$(request.resource.data.sharedMenuId)) &&
        getAfter(/databases/$(database)/documents/restaurant_menus/$(request.resource.data.sharedMenuId)).data.bitescoreRestaurantId == restaurantId &&
        getAfter(/databases/$(database)/documents/restaurant_menus/$(request.resource.data.sharedMenuId)).data.createdByUserId == request.auth.uid;
    }

    function legacyReviewReport(data) {
      return data.get('reportScope', 'review') == 'review' &&
        !data.keys().hasAny(['reportedUserId', 'evidence', 'imageId', 'targetFingerprint', 'supportingReviewId']);
    }

    function ownerContentTermsAllowed(userId) {
      return isAdmin() || (resource != null && ownerWithdrawalOnly()) || sharedTermsAccepted(userId);
    }

    function ownerImageCreateAllowed(field) {
      return !ownerPhotoScreeningRequired() || (!request.resource.data.keys().hasAny(['screeningImageId', 'screeningTargetToken']) && (request.resource.data.get(field, null) == null || request.resource.data.get(field, '') == ''));
    }

    function ownerImageUpdateAllowed(field) {
      return !ownerPhotoScreeningRequired() || (!changedKeys().hasAny(['screeningImageId', 'screeningTargetToken', 'storagePath']) && (!changedKeys().hasAny([field]) || request.resource.data.get(field, null) == null || request.resource.data.get(field, '') == ''));
    }

    function ownerPhotoScreeningRequired() {
      let path = /databases/$(database)/documents/private_bitescore_runtime/photo_screening;
      return exists(path) && get(path).data.get('ownerRequired', false) == true;
    }

    function ownerWithdrawalOnly() {
      return changedKeys().hasOnly(['updatedAt', 'isActive', 'imageUrl', 'mainImageUrl', 'bio', 'description', 'details', 'restaurantWriteRevision']) &&
        (!changedKeys().hasAny(['isActive']) || request.resource.data.isActive == false) &&
        (!changedKeys().hasAny(['imageUrl']) || request.resource.data.get('imageUrl', null) in [null, '']) &&
        (!changedKeys().hasAny(['mainImageUrl']) || request.resource.data.get('mainImageUrl', null) in [null, '']) &&
        (!changedKeys().hasAny(['details']) || request.resource.data.get('details', null) in [null, '']) &&
        (!changedKeys().hasAny(['bio']) || request.resource.data.get('bio', null) in [null, '']) &&
        (!changedKeys().hasAny(['description']) || request.resource.data.get('description', null) in [null, '']);
    }

    function postingRestrictionInactive(data) {
      return data.schemaVersion == 1 && data.revision is int && data.revision > 0 &&
        data.kind in ['7d', '14d', 'indefinite'] && data.startsAt is timestamp &&
        ((data.kind == 'indefinite' && data.endsAt == null) ||
          (data.kind != 'indefinite' && data.endsAt is timestamp && data.endsAt > data.startsAt)) &&
        (data.releasedAt is timestamp ||
          (data.releasedAt == null && data.kind != 'indefinite' && request.time >= data.endsAt));
    }

    function publicIdentityTermsAllowed() {
      return !customerTermsRequired() ||
        (resource != null && !changedKeys().hasAny(['publicDisplayName', 'fallbackUsername', 'username', 'chosenUsername', 'chosenUsernameNormalized'])) ||
        generatedPublicIdentity(request.resource.data) ||
        (customerPostingAllowed() && customerTermsAccepted());
    }

    function generatedPublicIdentity(data) {
      return data.get('fallbackUsername', '') is string && data.fallbackUsername.matches('^anon[0-9]{1,6}$') &&
        data.get('publicDisplayName', '') == data.fallbackUsername &&
        data.get('username', null) == null && data.get('chosenUsername', null) == null &&
        data.get('chosenUsernameNormalized', null) in [null, ''];
    }

    function publicUsernameTermsAllowed(username) {
      return !customerTermsRequired() ||
        (username.matches('^anon[0-9]{1,6}$') && request.resource.data.get('username', '') == username &&
          request.resource.data.get('reservationType', '') == 'fallback' &&
          request.resource.data.keys().hasOnly(['username', 'userId', 'reservationType', 'createdAt', 'updatedAt'])) ||
        (customerPostingAllowed() && customerTermsAccepted());
    }

    function restaurantProfileTermsAllowed(userId) {
      return (!customerTermsRequired()) ||
        (resource != null && ownerWithdrawalOnly()) ||
        (resource != null && !changedKeys().hasAny(['restaurantName', 'name', 'streetAddress', 'address', 'city', 'state', 'zipCode', 'postalCode', 'phone', 'website', 'bio', 'description', 'mainImageUrl', 'businessHours', 'latitude', 'longitude', 'couponApplicationSubmitted', 'menuSourceSide', 'linkedBiteScoreRestaurantId', 'ownerMedia', 'cuisineTags', 'approvalStatus'])) ||
        (isAdmin() && (resource == null || request.resource.data.get('approvalStatus', '') != 'approved' || resource.data.get('approvalStatus', '') == 'approved')) ||
        (resource == null && !request.resource.data.keys().hasAny(['restaurantName', 'name', 'address', 'streetAddress', 'bio', 'description', 'mainImageUrl', 'couponApplicationSubmitted'])) ||
        sharedTermsAccepted(resource != null && isAdmin() ? resource.data.get('uid', userId) : userId);
    }

    function reviewDataHasBlockingMergeLock(reviewData) {
      return reviewData.keys().hasAny(['dishId']) &&
        mergeLockBlocksClientReviews(reviewData.dishId);
    }

    function mergeLockBlocksClientReviews(dishId) {
      return canonicalDishId(dishId) &&
        exists(/databases/$(database)/documents/private_dish_merge_review_locks/$(dishId));
    }

    function reviewDataHasCanonicalDishId(reviewData) {
      return reviewData.keys().hasAny(['dishId']) &&
        canonicalExistingDishId(reviewData.dishId);
    }

    function canonicalExistingDishId(dishId) {
      return canonicalDishId(dishId) &&
        get(/databases/$(database)/documents/bitescore_dishes/$(dishId)).data.id == dishId;
    }

    function reviewDataUserAllowsMilestoneMutation(reviewData) {
      return reviewData.keys().hasAny(['userId']) &&
        reviewMilestoneLockAllowsClientMutation(reviewData.userId);
    }

    function reviewMilestoneLockAllowsClientMutation(userId) {
      let lockPath = /databases/$(database)/documents/private_review_milestone_reconciliation_locks/$(userId);
      let lock = get(lockPath);
      return canonicalPrivateReviewMilestoneIdentity(userId) &&
        (
          lock == null ||
          strictReleasedReviewMilestoneLock(userId, lock.data)
        );
    }

    function canonicalPrivateReviewMilestoneIdentity(value) {
      return value is string &&
        value.size() > 0 &&
        value.matches('^[^/\\s\\p{Cc}](?:[^/\\p{Cc}]*[^/\\s\\p{Cc}])?$') &&
        value != '.' &&
        value != '..' &&
        !value.matches('^__.*__$') &&
        value.toUtf8().size() <= 1500;
    }

    function sharedTermsAccepted(userId) {
      return !customerTermsRequired() || (signedIn() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' && currentTermsReceipt(userId));
    }

    function strictReleasedReviewMilestoneLock(userId, lockData) {
      return lockData.keys().hasAll([
          'version',
          'userId',
          'operationId',
          'lockToken',
          'state',
          'createdAt',
          'updatedAt',
          'fingerprint'
        ]) &&
        lockData.keys().hasOnly([
          'version',
          'userId',
          'operationId',
          'lockToken',
          'state',
          'createdAt',
          'updatedAt',
          'fingerprint'
        ]) &&
        lockData.version == 'bitestar.review-milestone-lock.v1' &&
        lockData.userId == userId &&
        canonicalPrivateReviewMilestoneIdentity(lockData.userId) &&
        canonicalPrivateReviewMilestoneIdentity(lockData.operationId) &&
        lockData.lockToken is string &&
        lockData.lockToken.matches('^[0-9a-f]{64}$') &&
        lockData.state == 'released' &&
        lockData.createdAt is timestamp &&
        lockData.updatedAt is timestamp &&
        lockData.updatedAt >= lockData.createdAt &&
        lockData.fingerprint is string &&
        lockData.fingerprint.matches('^[0-9a-f]{64}$');
    }

    function validBiteScoreRestaurantUpdateRevision() {
      return validBiteScoreRestaurantWriteRevision(resource.data) &&
        validBiteScoreRestaurantWriteRevision(request.resource.data) &&
        request.resource.data.restaurantWriteRevision ==
          resource.data.restaurantWriteRevision + 1;
    }

    function validBiteScoreRestaurantWriteRevision(data) {
      return data.keys().hasAny(['restaurantWriteRevision']) &&
        data.restaurantWriteRevision is int &&
        data.restaurantWriteRevision >= 0 &&
        data.restaurantWriteRevision <= 9007199254740991;
    }

    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return signedIn() &&
        request.auth.token.keys().hasAny(['email_verified']) &&
        request.auth.token.email_verified == true;
    }

    function betaAdminEmails() {
      return ['schuyler.cole@gmail.com'];
    }

    function hasAdminClaim() {
      return signedIn() &&
        request.auth.token.keys().hasAny(['admin']) &&
        request.auth.token.admin == true;
    }

    function hasBetaAdminEmail() {
      return signedIn() &&
        request.auth.token.keys().hasAny(['email']) &&
        request.auth.token.email in betaAdminEmails();
    }

    function isAdmin() {
      return hasAdminClaim() || hasBetaAdminEmail();
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isApprovedRestaurantAccount(restaurantUid) {
      return exists(/databases/$(database)/documents/restaurant_accounts/$(restaurantUid)) &&
        get(/databases/$(database)/documents/restaurant_accounts/$(restaurantUid)).data.approvalStatus == 'approved';
    }

    function restaurantAccountHasPostingAccess(restaurantUid) {
      return exists(/databases/$(database)/documents/restaurant_accounts/$(restaurantUid)) &&
        get(/databases/$(database)/documents/restaurant_accounts/$(restaurantUid)).data.approvalStatus == 'approved' &&
        (
          get(/databases/$(database)/documents/restaurant_accounts/$(restaurantUid)).data.couponPostingEnabled == true ||
          get(/databases/$(database)/documents/restaurant_accounts/$(restaurantUid)).data.subscriptionStatus in ['active', 'trialing']
        );
    }

    function canManageRestaurantContent(restaurantUid) {
      return isAdmin() || (isSelf(restaurantUid) && restaurantAccountHasPostingAccess(restaurantUid));
    }

    function restaurantAccountProtectedFields() {
      return [
        'approvalStatus',
        'approvedAt',
        'approvedByUid',
        'billingPlanName',
        'couponPostingEnabled',
        'hasUsedTrial',
        'lastSubscriptionSyncAt',
        'stripeCheckoutSessionId',
        'stripeCustomerId',
        'stripePriceId',
        'stripeSubscriptionId',
        'subscriptionEndsAt',
        'subscriptionStatus',
        'trialEndsAt'
      ];
    }

    function restaurantAccountOwnerLockedFields() {
      return [
        'uid',
        'createdAt',
        'deletedAt',
        'deletedByUid',
        'inviteId',
        'inviteRestaurantKey',
        'inviteTokenHash',
        'tokenHash'
      ];
    }

    function restaurantAccountClientWritableFields() {
      return [
        'uid',
        'email',
        'phoneNumber',
        'displayName',
        'restaurantName',
        'name',
        'streetAddress',
        'address',
        'city',
        'state',
        'zipCode',
        'postalCode',
        'phone',
        'website',
        'bio',
        'description',
        'mainImageUrl',
        'businessHours',
        'latitude',
        'longitude',
        'emailVerified',
        'couponApplicationSubmitted',
        'approvalStatus',
        'menuSourceSide',
        'linkedBiteScoreRestaurantId',
        'menuSourceUpdatedAt',
        'menuSourceUpdatedBy',
        'createdAt',
        'updatedAt'
      ];
    }

    function restaurantAccountMenuRoutingFields() {
      return [
        'menuSourceSide',
        'linkedBiteScoreRestaurantId',
        'menuSourceUpdatedAt',
        'menuSourceUpdatedBy'
      ];
    }

    function validRestaurantAccountMenuRoutingState() {
      return !('menuSourceSide' in request.resource.data) ||
        (
          request.resource.data.menuSourceSide == 'biteSaver' &&
          !('linkedBiteScoreRestaurantId' in request.resource.data)
        ) ||
        (
          request.resource.data.menuSourceSide == 'biteScore' &&
          request.resource.data.linkedBiteScoreRestaurantId is string &&
          request.resource.data.linkedBiteScoreRestaurantId.size() > 0
        );
    }

    function validRestaurantAccountMenuRoutingUpdate() {
      return !changedKeys().hasAny(restaurantAccountMenuRoutingFields()) ||
        (
          request.resource.data.menuSourceUpdatedBy == request.auth.uid &&
          validRestaurantAccountMenuRoutingState()
        );
    }

    function canCreateOwnRestaurantAccount(restaurantUid) {
      return isSelf(restaurantUid) &&
        request.resource.data.uid == restaurantUid &&
        request.resource.data.keys().hasOnly(restaurantAccountClientWritableFields()) &&
        !request.resource.data.keys().hasAny(restaurantAccountMenuRoutingFields()) &&
        (!('approvalStatus' in request.resource.data) ||
          request.resource.data.approvalStatus == 'pending') &&
        !request.resource.data.keys().hasAny([
          'approvedAt',
          'approvedByUid',
          'billingPlanName',
          'couponPostingEnabled',
          'hasUsedTrial',
          'lastSubscriptionSyncAt',
          'stripeCheckoutSessionId',
          'stripeCustomerId',
          'stripePriceId',
          'stripeSubscriptionId',
          'subscriptionEndsAt',
          'subscriptionStatus',
          'trialEndsAt'
        ]);
    }

    function canUpdateOwnRestaurantAccount(restaurantUid) {
      return isSelf(restaurantUid) &&
        request.resource.data.uid == restaurantUid &&
        !changedKeys().hasAny(restaurantAccountProtectedFields()) &&
        !changedKeys().hasAny(restaurantAccountOwnerLockedFields()) &&
        changedKeys().hasOnly(restaurantAccountClientWritableFields()) &&
        validRestaurantAccountMenuRoutingUpdate();
    }

    function profileWritableFields() {
      return [
        'userId',
        'email',
        'phoneNumber',
        'displayName',
        'photoURL',
        'providerIds',
        'isAnonymous',
        'updatedAt'
      ];
    }

    function canCreateOwnProfile(userId) {
      return isSelf(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.keys().hasOnly(profileWritableFields());
    }

    function canUpdateOwnProfile(userId) {
      return isSelf(userId) &&
        request.resource.data.userId == userId &&
        changedKeys().hasOnly(profileWritableFields());
    }

    function userOwnedCreate(userId) {
      return isSelf(userId) && request.resource.data.userId == userId;
    }

    function userOwnedUpdate(userId) {
      return isSelf(userId) &&
        resource.data.userId == userId &&
        request.resource.data.userId == userId;
    }

    function ownerOfBiteScoreRestaurant(restaurantId) {
      return signedIn() &&
        restaurantId is string &&
        exists(/databases/$(database)/documents/bitescore_restaurants/$(restaurantId)) &&
        get(/databases/$(database)/documents/bitescore_restaurants/$(restaurantId)).data.isClaimed == true &&
        get(/databases/$(database)/documents/bitescore_restaurants/$(restaurantId)).data.ownerUserId == request.auth.uid;
    }

    function ownsSharedRestaurantMenu(menuId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/restaurant_menus/$(menuId)) &&
        get(/databases/$(database)/documents/restaurant_menus/$(menuId)).data.createdByUserId == request.auth.uid;
    }

    function biteScoreRestaurantOwnerFields() {
      return [
        'name',
        'restaurantName',
        'normalizedName',
        'address',
        'streetAddress',
        'formattedAddress',
        'fullAddress',
        'city',
        'state',
        'stateCode',
        'zipCode',
        'postalCode',
        'phone',
        'website',
        'bio',
        'businessHours',
        'cuisineTags',
        'location',
        'geoPoint',
        'latitude',
        'longitude',
        'sharedMenuId',
        'menuSourceSide',
        'linkedBiteSaverUid',
        'menuSourceUpdatedAt',
        'menuSourceUpdatedBy',
        'updatedAt'
      ];
    }

    function biteScoreRestaurantMenuRoutingFields() {
      return [
        'menuSourceSide',
        'linkedBiteSaverUid',
        'menuSourceUpdatedAt',
        'menuSourceUpdatedBy'
      ];
    }

    function validBiteScoreRestaurantMenuRoutingState() {
      return !('menuSourceSide' in request.resource.data) ||
        (
          request.resource.data.menuSourceSide == 'biteScore' &&
          !('linkedBiteSaverUid' in request.resource.data)
        ) ||
        (
          request.resource.data.menuSourceSide == 'biteSaver' &&
          request.resource.data.linkedBiteSaverUid is string &&
          request.resource.data.linkedBiteSaverUid.size() > 0
        );
    }

    function validBiteScoreRestaurantMenuRoutingUpdate() {
      return !changedKeys().hasAny(biteScoreRestaurantMenuRoutingFields()) ||
        (
          request.resource.data.menuSourceUpdatedBy == request.auth.uid &&
          validBiteScoreRestaurantMenuRoutingState()
        );
    }

    function canOwnerUpdateBiteScoreRestaurant(restaurantId) {
      return ownerOfBiteScoreRestaurant(restaurantId) &&
        changedKeys().hasOnly(biteScoreRestaurantOwnerFields()) &&
        validBiteScoreRestaurantMenuRoutingUpdate();
    }

    function nonEmptyRequestString(fieldName) {
      return request.resource.data[fieldName] is string &&
        request.resource.data[fieldName].size() > 0;
    }

    function biteScoreDishProvenanceFields() {
      return [
        'createdByUserId',
        'createdFromReviewId',
        'createdWithRestaurantId',
        'createdFromCreateFlow'
      ];
    }

    function biteScoreRestaurantProvenanceFields() {
      return [
        'createdByUserId',
        'createdFromDishId',
        'createdFromReviewId',
        'createdFromCreateFlow'
      ];
    }

    function biteScoreRestaurantCompletionFields() {
      return [
        'createdFromDishId',
        'createdFromReviewId'
      ];
    }

    function validBiteScoreDishCreateProvenance() {
      return request.resource.data.createdByUserId == request.auth.uid &&
        request.resource.data.createdFromCreateFlow == true &&
        nonEmptyRequestString('createdFromReviewId') &&
        nonEmptyRequestString('createdWithRestaurantId') &&
        request.resource.data.createdWithRestaurantId == request.resource.data.restaurantId;
    }

    function biteScoreDishProvenanceUnchanged() {
      return !changedKeys().hasAny(biteScoreDishProvenanceFields());
    }

    function validBiteScoreRestaurantInitialProvenance() {
      return request.resource.data.createdByUserId == request.auth.uid &&
        request.resource.data.createdFromCreateFlow == true &&
        !('createdFromDishId' in request.resource.data) &&
        !('createdFromReviewId' in request.resource.data);
    }

    function completesMissingRestaurantDishProvenance() {
      return !changedKeys().hasAny(['createdFromDishId']) ||
        (
          !('createdFromDishId' in resource.data) &&
          nonEmptyRequestString('createdFromDishId')
        );
    }

    function completesMissingRestaurantReviewProvenance() {
      return !changedKeys().hasAny(['createdFromReviewId']) ||
        (
          !('createdFromReviewId' in resource.data) &&
          nonEmptyRequestString('createdFromReviewId')
        );
    }

    function canCompleteBiteScoreRestaurantProvenance() {
      return emailVerified() &&
        resource.data.createdByUserId == request.auth.uid &&
        resource.data.createdFromCreateFlow == true &&
        changedKeys().hasOnly(biteScoreRestaurantCompletionFields()) &&
        changedKeys().hasAny(biteScoreRestaurantCompletionFields()) &&
        completesMissingRestaurantDishProvenance() &&
        completesMissingRestaurantReviewProvenance();
    }

    function biteScoreRestaurantProvenanceUnchanged() {
      return !changedKeys().hasAny(biteScoreRestaurantProvenanceFields());
    }

    function canCreatePublicBiteScoreRestaurant(restaurantId) {
      return emailVerified() &&
        request.resource.data.id == restaurantId &&
        validBiteScoreRestaurantInitialProvenance() &&
        (!('ownerUserId' in request.resource.data) ||
          request.resource.data.ownerUserId == null ||
          request.resource.data.ownerUserId == '') &&
        (!('isClaimed' in request.resource.data) ||
          request.resource.data.isClaimed == false) &&
        (!('isActive' in request.resource.data) ||
          request.resource.data.isActive == true) &&
        (!('active' in request.resource.data) ||
          request.resource.data.active == true);
    }

    function createsOwnReview() {
      return emailVerified() && request.resource.data.userId == request.auth.uid;
    }

    function updatesOwnReview() {
      return emailVerified() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
    }

    function createsOwnReport(reportingField) {
      return emailVerified() &&
        request.resource.data[reportingField] == request.auth.uid &&
        request.resource.data.status == 'pending';
    }

    function readsOwnReport(reportingField) {
      return signedIn() && resource.data[reportingField] == request.auth.uid;
    }

    function updatesOwnReport(reportingField) {
      return emailVerified() &&
        resource.data[reportingField] == request.auth.uid &&
        request.resource.data[reportingField] == request.auth.uid &&
        changedKeys().hasOnly(['reason', 'message', 'note', 'updatedAt']);
    }

    function createsOwnDishEditProposal() {
      return emailVerified() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
    }

    function readsOwnDishEditProposal() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function createsOwnClaimRequest() {
      return emailVerified() &&
        request.resource.data.requesterUserId == request.auth.uid &&
        request.resource.data.status == 'pending';
    }

    function readsOwnClaimRequest() {
      return signedIn() && resource.data.requesterUserId == request.auth.uid;
    }

    function publicProfileWriteFields() {
      return [
        'userId',
        'publicDisplayName',
        'fallbackUsername',
        'username',
        'chosenUsername',
        'chosenUsernameNormalized',
        'createdAt',
        'updatedAt'
      ];
    }

    function canWriteOwnPublicReviewerProfile(userId) {
      return isSelf(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.keys().hasOnly(publicProfileWriteFields());
    }

    function canUpdateOwnPublicReviewerProfile(userId) {
      return isSelf(userId) &&
        resource.data.userId == userId &&
        request.resource.data.userId == userId &&
        changedKeys().hasOnly(publicProfileWriteFields());
    }

    function canAcknowledgeOwnLocalExpertBadgeCelebration(userId) {
      return isSelf(userId) &&
        changedKeys().hasOnly(['status', 'celebratedAt', 'updatedAt']) &&
        (
          !changedKeys().hasAny(['status']) ||
          request.resource.data.status == 'celebrated'
        );
    }

    function restaurantNameChangeRequestCreateFields() {
      return [
        'userId',
        'currentRestaurantName',
        'requestedRestaurantName',
        'status',
        'createdAt'
      ];
    }

