rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function deletionActorMayWrite() {
      return signedIn() && !firestore.exists(/databases/(default)/documents/private_account_deletions/$(request.auth.uid));
    }

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return deletionActorMayWrite() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        (
          (request.auth.token.keys().hasAny(['admin']) &&
            request.auth.token.admin == true) ||
          (request.auth.token.keys().hasAny(['email']) &&
            request.auth.token.email == 'schuyler.cole@gmail.com')
        );
    }

    function isAllowedImage() {
      return request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function hasNoCustomMetadata() {
      return request.resource != null &&
        request.resource.metadata.keys().hasOnly([]);
    }

    function isSharedMenuOwner(menuId) {
      return deletionActorMayWrite()
        && firestore.exists(/databases/(default)/documents/restaurant_menus/$(menuId))
        && firestore.get(/databases/(default)/documents/restaurant_menus/$(menuId)).data.createdByUserId == request.auth.uid;
    }

    function ownsAuthorizedMenuImageSource(grant) {
      return signedIn() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        grant.ownerUserId == request.auth.uid &&
        (
          (
            grant.sourceType == 'biteSaver' &&
            grant.sourceId == request.auth.uid &&
            firestore.exists(/databases/(default)/documents/restaurant_accounts/$(grant.sourceId)) &&
            firestore.get(/databases/(default)/documents/restaurant_accounts/$(grant.sourceId)).data.approvalStatus == 'approved' &&
            firestore.get(/databases/(default)/documents/restaurant_accounts/$(grant.sourceId)).data.couponPostingEnabled == true
          ) ||
          (
            grant.sourceType == 'sharedMenu' &&
            firestore.exists(/databases/(default)/documents/restaurant_menus/$(grant.sourceId)) &&
            firestore.get(/databases/(default)/documents/restaurant_menus/$(grant.sourceId)).data.createdByUserId == request.auth.uid
          )
        );
    }

    function canManageAuthorizedMenuImage(authorizationId, fileName) {
      let authorizationPath = /databases/(default)/documents/private_menu_image_upload_authorizations/$(authorizationId);
      let grant = firestore.get(authorizationPath).data;
      return authorizationId.matches('bsmia_[A-Za-z0-9_-]{43}') &&
        firestore.exists(authorizationPath) &&
        grant.keys().hasOnly([
          'schemaVersion',
          'state',
          'ownerUserId',
          'sourceType',
          'sourceId',
          'fileName',
          'createdAt'
        ]) &&
        grant.schemaVersion == 1 &&
        grant.state == 'active' &&
        grant.ownerUserId is string &&
        grant.sourceId is string &&
        grant.sourceId.size() > 0 &&
        grant.sourceId.size() <= 512 &&
        (grant.sourceType == 'biteSaver' || grant.sourceType == 'sharedMenu') &&
        grant.fileName == fileName &&
        (fileName == 'image.jpg' || fileName == 'image.png' || fileName == 'image.webp') &&
        grant.createdAt is timestamp &&
        (isAdmin() ? deletionActorMayWrite() : ownsAuthorizedMenuImageSource(grant));
    }

    function dishExists(dishId) {
      return firestore.exists(/databases/(default)/documents/bitescore_dishes/$(dishId));
    }

    // SOURCE CUTOVER CANDIDATE. Historical reads remain; screened bytes have
    // no token and need the exact immutable decision AND saved target.
    function screenedOwnerPhotoIsPublic(ownerKey, fileName) {
      let imageId = fileName.replace('screened_', '').replace('.jpg', '');
      let row = firestore.get(/databases/(default)/documents/private_bitescore_photo_screenings/$(imageId)).data;
      return row.lane == 'owner' && row.state == 'approved' && row.get('attached', false) == true &&
        resource.metadata.uploaderKey == ownerKey && row.generation == string(resource.generation) &&
        row.storagePath == 'bitescore_user_uploads/' + ownerKey + '/owner_images/' + fileName &&
        screenedOwnerTargetMatches(row);
    }
    function screenedOwnerTargetMatches(row) {
      return row.family == 'managed' && row.targetId != 'gallery' ?
        screenedOwnerSpecialMatches(row, firestore.get(/databases/(default)/documents/restaurant_accounts/$(row.sourceId)/daily_specials/$(row.targetId == 'board' ? 'bitesaver_managed_board' : row.targetId)).data) :
        row.family == 'menu' ? (
        row.sourceType == 'biteSaver' ?
          firestore.get(/databases/(default)/documents/restaurant_accounts/$(row.sourceId)/menu_images/$(row.targetId)).data.imageUrl == row.publicUrl :
          firestore.get(/databases/(default)/documents/restaurant_menus/$(row.sourceId)/menu_images/$(row.targetId)).data.imageUrl == row.publicUrl
      ) : row.family == 'coupon' ?
        firestore.get(/databases/(default)/documents/restaurant_accounts/$(row.sourceId)/coupons/$(row.targetId)).data.imageUrl == row.publicUrl :
        screenedOwnerRestaurantMatches(row, firestore.get(/databases/(default)/documents/restaurant_accounts/$(row.sourceId)).data);
    }
    function screenedOwnerSpecialMatches(row, special) {
      return special.imageUrl == row.publicUrl &&
        (row.targetId == 'board' || special.screeningTargetToken == row.targetToken);
    }
    function screenedOwnerRestaurantMatches(row, account) {
      return row.family == 'main' ? (account.get('mainImageUrl', null) == row.publicUrl ||
        (account.get('ownerMedia', {}).get('legacyMain', null) == row.publicUrl &&
          'legacy-main' in account.get('ownerMedia', {}).get('gallery', []))) :
        row.family == 'managed' && account.ownerMedia.version == row.publishedMediaVersion;
    }

    match /bitescore_user_uploads/{ownerKey}/owner_images/{fileName} {
      allow get: if fileName.matches('screened_bso_[a-f0-9]{64}[.]jpg') && screenedOwnerPhotoIsPublic(ownerKey, fileName);
      allow list, create, update, delete: if false;
    }

    match /bitesaver_restaurants/{uid}/restaurant_images/{fileName} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isOwner(uid);
    }

    match /bitesaver_restaurants/{uid}/coupon_images/{fileName} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isOwner(uid);
    }

    match /bitesaver_restaurants/{uid}/menu_images/{fileName} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isOwner(uid);
    }

    match /restaurant_menus/{menuId}/menu_images/{fileName} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if isSharedMenuOwner(menuId);
    }

    // Acceptance transaction revokes every owned grant; issuance reads the
    // owner fence. Owner uses grant+source; Admin uses grant+actor fence (2).
    match /public_menu_images/{authorizationId}/{fileName} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if canManageAuthorizedMenuImage(authorizationId, fileName);
    }

    match /bitescore_dishes/{dishId}/images/{fileName} {
      allow read: if true;
      // Retired unowned namespace remains readable; new bytes need immutable ownership.
      allow create: if false;
      allow update, delete: if false;
    }

    // SOURCE CUTOVER CANDIDATE: coordinate with screened clients + backend.
    // Historical objects stay readable; no client may create new public bytes.
    match /bitescore_user_uploads/{ownerKey}/dish_images/{dishId}/{fileName} {
      function screenedImageId() { return fileName.replace('screened_', '').replace('.jpg', ''); }
      function screenedPhotoIsPublic() {
        let imageId = screenedImageId();
        let source = firestore.get(/databases/(default)/documents/bitescore_dish_images/$(imageId)).data;
        let screening = firestore.get(/databases/(default)/documents/private_bitescore_photo_screenings/$(imageId)).data;
        return screening.state == 'approved' && screening.generation == string(resource.generation) &&
          source.screeningStatus == 'approved' && source.get('moderationStatus', '') != 'removed' &&
          source.storageGeneration == string(resource.generation) && source.dishId == dishId &&
          source.storagePath == 'bitescore_user_uploads/' + ownerKey + '/dish_images/' + dishId + '/' + fileName &&
          screening.storagePath == source.storagePath;
      }
      allow get: if !fileName.matches('screened_.*') ||
        (fileName.matches('screened_bss_[a-f0-9]{64}[.]jpg') && screenedPhotoIsPublic());
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
