rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return signedIn() &&
        request.auth.token.keys().hasAny(['email_verified']) &&
        request.auth.token.email_verified == true;
    }

    function betaAdminEmails() {
      return ['schuyler.cole@gmail.com'];
    }

    function hasAdminClaim() {
      return signedIn() &&
        request.auth.token.keys().hasAny(['admin']) &&
        request.auth.token.admin == true;
    }

    function hasBetaAdminEmail() {
      return signedIn() &&
        request.auth.token.keys().hasAny(['email']) &&
        request.auth.token.email in betaAdminEmails();
    }

    function isAdmin() {
      return hasAdminClaim() || hasBetaAdminEmail();
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isApprovedRestaurantAccount(restaurantUid) {
      return exists(/databases/$(database)/documents/restaurant_accounts/$(restaurantUid)) &&
        get(/databases/$(database)/documents/restaurant_accounts/$(restaurantUid)).data.approvalStatus == 'approved';
    }

    function restaurantAccountHasPostingAccess(restaurantUid) {
      return exists(/databases/$(database)/documents/restaurant_accounts/$(restaurantUid)) &&
        get(/databases/$(database)/documents/restaurant_accounts/$(restaurantUid)).data.approvalStatus == 'approved' &&
        (
          get(/databases/$(database)/documents/restaurant_accounts/$(restaurantUid)).data.couponPostingEnabled == true ||
          get(/databases/$(database)/documents/restaurant_accounts/$(restaurantUid)).data.subscriptionStatus in ['active', 'trialing']
        );
    }

    function canManageRestaurantContent(restaurantUid) {
      return isAdmin() || (isSelf(restaurantUid) && restaurantAccountHasPostingAccess(restaurantUid));
    }

    function restaurantAccountProtectedFields() {
      return [
        'approvalStatus',
        'approvedAt',
        'approvedByUid',
        'billingPlanName',
        'couponPostingEnabled',
        'hasUsedTrial',
        'lastSubscriptionSyncAt',
        'stripeCheckoutSessionId',
        'stripeCustomerId',
        'stripePriceId',
        'stripeSubscriptionId',
        'subscriptionEndsAt',
        'subscriptionStatus',
        'trialEndsAt'
      ];
    }

    function restaurantAccountOwnerLockedFields() {
      return [
        'uid',
        'createdAt',
        'deletedAt',
        'deletedByUid',
        'inviteId',
        'inviteRestaurantKey',
        'inviteTokenHash',
        'tokenHash'
      ];
    }

    function restaurantAccountClientWritableFields() {
      return [
        'uid',
        'email',
        'phoneNumber',
        'displayName',
        'restaurantName',
        'name',
        'streetAddress',
        'address',
        'city',
        'state',
        'zipCode',
        'postalCode',
        'phone',
        'website',
        'bio',
        'description',
        'mainImageUrl',
        'businessHours',
        'latitude',
        'longitude',
        'emailVerified',
        'couponApplicationSubmitted',
        'approvalStatus',
        'menuSourceSide',
        'linkedBiteScoreRestaurantId',
        'menuSourceUpdatedAt',
        'menuSourceUpdatedBy',
        'createdAt',
        'updatedAt'
      ];
    }

    function restaurantAccountMenuRoutingFields() {
      return [
        'menuSourceSide',
        'linkedBiteScoreRestaurantId',
        'menuSourceUpdatedAt',
        'menuSourceUpdatedBy'
      ];
    }

    function validRestaurantAccountMenuRoutingState() {
      return !('menuSourceSide' in request.resource.data) ||
        (
          request.resource.data.menuSourceSide == 'biteSaver' &&
          !('linkedBiteScoreRestaurantId' in request.resource.data)
        ) ||
        (
          request.resource.data.menuSourceSide == 'biteScore' &&
          request.resource.data.linkedBiteScoreRestaurantId is string &&
          request.resource.data.linkedBiteScoreRestaurantId.size() > 0
        );
    }

    function validRestaurantAccountMenuRoutingUpdate() {
      return !changedKeys().hasAny(restaurantAccountMenuRoutingFields()) ||
        (
          request.resource.data.menuSourceUpdatedBy == request.auth.uid &&
          validRestaurantAccountMenuRoutingState()
        );
    }

    function canCreateOwnRestaurantAccount(restaurantUid) {
      return isSelf(restaurantUid) &&
        request.resource.data.uid == restaurantUid &&
        request.resource.data.keys().hasOnly(restaurantAccountClientWritableFields()) &&
        !request.resource.data.keys().hasAny(restaurantAccountMenuRoutingFields()) &&
        (!('approvalStatus' in request.resource.data) ||
          request.resource.data.approvalStatus == 'pending') &&
        !request.resource.data.keys().hasAny([
          'approvedAt',
          'approvedByUid',
          'billingPlanName',
          'couponPostingEnabled',
          'hasUsedTrial',
          'lastSubscriptionSyncAt',
          'stripeCheckoutSessionId',
          'stripeCustomerId',
          'stripePriceId',
          'stripeSubscriptionId',
          'subscriptionEndsAt',
          'subscriptionStatus',
          'trialEndsAt'
        ]);
    }

    function canUpdateOwnRestaurantAccount(restaurantUid) {
      return isSelf(restaurantUid) &&
        request.resource.data.uid == restaurantUid &&
        !changedKeys().hasAny(restaurantAccountProtectedFields()) &&
        !changedKeys().hasAny(restaurantAccountOwnerLockedFields()) &&
        changedKeys().hasOnly(restaurantAccountClientWritableFields()) &&
        validRestaurantAccountMenuRoutingUpdate();
    }

    function profileWritableFields() {
      return [
        'userId',
        'email',
        'phoneNumber',
        'displayName',
        'photoURL',
        'providerIds',
        'isAnonymous',
        'updatedAt'
      ];
    }

    function canCreateOwnProfile(userId) {
      return isSelf(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.keys().hasOnly(profileWritableFields());
    }

    function canUpdateOwnProfile(userId) {
      return isSelf(userId) &&
        request.resource.data.userId == userId &&
        changedKeys().hasOnly(profileWritableFields());
    }

    function userOwnedCreate(userId) {
      return isSelf(userId) && request.resource.data.userId == userId;
    }

    function userOwnedUpdate(userId) {
      return isSelf(userId) &&
        resource.data.userId == userId &&
        request.resource.data.userId == userId;
    }

    function ownerOfBiteScoreRestaurant(restaurantId) {
      return signedIn() &&
        restaurantId is string &&
        exists(/databases/$(database)/documents/bitescore_restaurants/$(restaurantId)) &&
        get(/databases/$(database)/documents/bitescore_restaurants/$(restaurantId)).data.isClaimed == true &&
        get(/databases/$(database)/documents/bitescore_restaurants/$(restaurantId)).data.ownerUserId == request.auth.uid;
    }

    function ownsSharedRestaurantMenu(menuId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/restaurant_menus/$(menuId)) &&
        get(/databases/$(database)/documents/restaurant_menus/$(menuId)).data.createdByUserId == request.auth.uid;
    }

    function biteScoreRestaurantOwnerFields() {
      return [
        'name',
        'restaurantName',
        'normalizedName',
        'address',
        'streetAddress',
        'formattedAddress',
        'fullAddress',
        'city',
        'state',
        'stateCode',
        'zipCode',
        'postalCode',
        'phone',
        'website',
        'bio',
        'businessHours',
        'cuisineTags',
        'location',
        'geoPoint',
        'latitude',
        'longitude',
        'sharedMenuId',
        'menuSourceSide',
        'linkedBiteSaverUid',
        'menuSourceUpdatedAt',
        'menuSourceUpdatedBy',
        'restaurantWriteRevision',
        'updatedAt'
      ];
    }

    function biteScoreRestaurantMenuRoutingFields() {
      return [
        'menuSourceSide',
        'linkedBiteSaverUid',
        'menuSourceUpdatedAt',
        'menuSourceUpdatedBy'
      ];
    }

    function validBiteScoreRestaurantMenuRoutingState() {
      return !('menuSourceSide' in request.resource.data) ||
        (
          request.resource.data.menuSourceSide == 'biteScore' &&
          !('linkedBiteSaverUid' in request.resource.data)
        ) ||
        (
          request.resource.data.menuSourceSide == 'biteSaver' &&
          request.resource.data.linkedBiteSaverUid is string &&
          request.resource.data.linkedBiteSaverUid.size() > 0
        );
    }

    function validBiteScoreRestaurantMenuRoutingUpdate() {
      return !changedKeys().hasAny(biteScoreRestaurantMenuRoutingFields()) ||
        (
          request.resource.data.menuSourceUpdatedBy == request.auth.uid &&
          validBiteScoreRestaurantMenuRoutingState()
        );
    }

    function canOwnerUpdateBiteScoreRestaurant(restaurantId) {
      return ownerOfBiteScoreRestaurant(restaurantId) &&
        changedKeys().hasOnly(biteScoreRestaurantOwnerFields()) &&
        validBiteScoreRestaurantMenuRoutingUpdate();
    }

    function nonEmptyRequestString(fieldName) {
      return request.resource.data[fieldName] is string &&
        request.resource.data[fieldName].size() > 0;
    }

    function biteScoreDishProvenanceFields() {
      return [
        'createdByUserId',
        'createdFromReviewId',
        'createdWithRestaurantId',
        'createdFromCreateFlow'
      ];
    }

    function biteScoreRestaurantProvenanceFields() {
      return [
        'createdByUserId',
        'createdFromDishId',
        'createdFromReviewId',
        'createdFromCreateFlow'
      ];
    }

    function biteScoreRestaurantCompletionFields() {
      return [
        'createdFromDishId',
        'createdFromReviewId'
      ];
    }

    function biteScoreRestaurantCompletionWriteFields() {
      return [
        'createdFromDishId',
        'createdFromReviewId',
        'restaurantWriteRevision'
      ];
    }

    function validBiteScoreRestaurantWriteRevision(data) {
      return data.keys().hasAny(['restaurantWriteRevision']) &&
        data.restaurantWriteRevision is int &&
        data.restaurantWriteRevision >= 0 &&
        data.restaurantWriteRevision <= 9007199254740991;
    }

    function validBiteScoreRestaurantCreateRevision() {
      return validBiteScoreRestaurantWriteRevision(request.resource.data) &&
        request.resource.data.restaurantWriteRevision == 0;
    }

    function validBiteScoreRestaurantUpdateRevision() {
      return validBiteScoreRestaurantWriteRevision(resource.data) &&
        validBiteScoreRestaurantWriteRevision(request.resource.data) &&
        request.resource.data.restaurantWriteRevision ==
          resource.data.restaurantWriteRevision + 1;
    }

    function validBiteScoreDishCreateProvenance() {
      return request.resource.data.createdByUserId == request.auth.uid &&
        request.resource.data.createdFromCreateFlow == true &&
        nonEmptyRequestString('createdFromReviewId') &&
        nonEmptyRequestString('createdWithRestaurantId') &&
        request.resource.data.createdWithRestaurantId == request.resource.data.restaurantId;
    }

    function biteScoreDishProvenanceUnchanged() {
      return !changedKeys().hasAny(biteScoreDishProvenanceFields());
    }

    function aggregateWriteGenerationAbsentOnClientCreate() {
      return !request.resource.data.keys().hasAny(['aggregateWriteGeneration']);
    }

    function aggregateWriteGenerationUnchanged() {
      return !changedKeys().hasAny(['aggregateWriteGeneration']);
    }

    function validBiteScoreRestaurantInitialProvenance() {
      return request.resource.data.createdByUserId == request.auth.uid &&
        request.resource.data.createdFromCreateFlow == true &&
        !('createdFromDishId' in request.resource.data) &&
        !('createdFromReviewId' in request.resource.data);
    }

    function completesMissingRestaurantDishProvenance() {
      return !changedKeys().hasAny(['createdFromDishId']) ||
        (
          !('createdFromDishId' in resource.data) &&
          nonEmptyRequestString('createdFromDishId')
        );
    }

    function completesMissingRestaurantReviewProvenance() {
      return !changedKeys().hasAny(['createdFromReviewId']) ||
        (
          !('createdFromReviewId' in resource.data) &&
          nonEmptyRequestString('createdFromReviewId')
        );
    }

    function canCompleteBiteScoreRestaurantProvenance() {
      return emailVerified() &&
        resource.data.createdByUserId == request.auth.uid &&
        resource.data.createdFromCreateFlow == true &&
        changedKeys().hasOnly(biteScoreRestaurantCompletionWriteFields()) &&
        changedKeys().hasAny(biteScoreRestaurantCompletionFields()) &&
        completesMissingRestaurantDishProvenance() &&
        completesMissingRestaurantReviewProvenance();
    }

    function biteScoreRestaurantProvenanceUnchanged() {
      return !changedKeys().hasAny(biteScoreRestaurantProvenanceFields());
    }

    function canCreatePublicBiteScoreRestaurant(restaurantId) {
      return emailVerified() &&
        request.resource.data.id == restaurantId &&
        validBiteScoreRestaurantInitialProvenance() &&
        (!('ownerUserId' in request.resource.data) ||
          request.resource.data.ownerUserId == null ||
          request.resource.data.ownerUserId == '') &&
        (!('isClaimed' in request.resource.data) ||
          request.resource.data.isClaimed == false) &&
        (!('isActive' in request.resource.data) ||
          request.resource.data.isActive == true) &&
        (!('active' in request.resource.data) ||
          request.resource.data.active == true);
    }

    function canonicalDishId(dishId) {
      return dishId is string &&
        dishId.size() > 0 &&
        dishId.matches('^[^/\\s\\p{Cc}](?:[^/\\p{Cc}]*[^/\\s\\p{Cc}])?$');
    }

    function canonicalDishProposalResolutionEntityId(entityId) {
      return canonicalDishId(entityId) &&
        entityId == entityId.trim() &&
        entityId != '.' &&
        entityId != '..' &&
        !entityId.matches('^__.*__$') &&
        entityId.toUtf8().size() <= 1500;
    }

    function dishProposalResolutionType(proposalData) {
      return proposalData.keys().hasAny(['type']) && proposalData.type != null
        ? proposalData.type
        : (
          proposalData.keys().hasAny(['targetType'])
            ? proposalData.targetType
            : null
        );
    }

    function dishProposalStoredTargetDishId(proposalData) {
      return proposalData.keys().hasAny(['targetDishId']) &&
          proposalData.targetDishId != null
        ? proposalData.targetDishId
        : (
          proposalData.keys().hasAny(['targetId'])
            ? proposalData.targetId
            : null
        );
    }

    function dishProposalSourceDishId(proposalData) {
      return proposalData.keys().hasAny(['sourceDishId']) &&
          proposalData.sourceDishId != null
        ? proposalData.sourceDishId
        : dishProposalStoredTargetDishId(proposalData);
    }

    function dishProposalMergeTargetDishId(proposalData) {
      return proposalData.keys().hasAny(['mergeTargetDishId']) &&
          proposalData.mergeTargetDishId != null
        ? proposalData.mergeTargetDishId
        : (
          dishProposalResolutionType(proposalData) == 'merge' &&
              proposalData.keys().hasAny(['sourceDishId']) &&
              proposalData.sourceDishId != null
            ? dishProposalStoredTargetDishId(proposalData)
            : null
        );
    }

    function dishProposalResolutionIdentitiesValid(proposalData) {
      let proposalType = dishProposalResolutionType(proposalData);
      let sourceDishId = dishProposalSourceDishId(proposalData);
      let storedTargetDishId = dishProposalStoredTargetDishId(proposalData);
      let mergeTargetDishId = dishProposalMergeTargetDishId(proposalData);
      return proposalData.keys().hasAny(['restaurantId']) &&
        (!proposalData.keys().hasAny(['type']) ||
          proposalData.type == null ||
          proposalData.type in ['rename', 'merge']) &&
        (!proposalData.keys().hasAny(['targetType']) ||
          proposalData.targetType == null ||
          proposalData.targetType in ['rename', 'merge']) &&
        (!(
          proposalData.keys().hasAny(['type']) &&
          proposalData.type != null &&
          proposalData.keys().hasAny(['targetType']) &&
          proposalData.targetType != null
        ) || proposalData.type == proposalData.targetType) &&
        proposalType in ['rename', 'merge'] &&
        canonicalDishProposalResolutionEntityId(proposalData.restaurantId) &&
        (!proposalData.keys().hasAny(['sourceDishId']) ||
          proposalData.sourceDishId == null ||
          canonicalDishProposalResolutionEntityId(
            proposalData.sourceDishId
          )) &&
        (!proposalData.keys().hasAny(['targetDishId']) ||
          proposalData.targetDishId == null ||
          canonicalDishProposalResolutionEntityId(
            proposalData.targetDishId
          )) &&
        (!proposalData.keys().hasAny(['targetId']) ||
          proposalData.targetId == null ||
          canonicalDishProposalResolutionEntityId(proposalData.targetId)) &&
        (!proposalData.keys().hasAny(['mergeTargetDishId']) ||
          proposalData.mergeTargetDishId == null ||
          canonicalDishProposalResolutionEntityId(
            proposalData.mergeTargetDishId
          )) &&
        canonicalDishProposalResolutionEntityId(sourceDishId) &&
        (!(
          proposalData.keys().hasAny(['targetDishId']) &&
          proposalData.targetDishId != null &&
          proposalData.keys().hasAny(['targetId']) &&
          proposalData.targetId != null
        ) || proposalData.targetDishId == proposalData.targetId) &&
        (proposalType != 'rename' ||
          !(
            proposalData.keys().hasAny(['sourceDishId']) &&
            proposalData.sourceDishId != null &&
            storedTargetDishId != null
          ) || proposalData.sourceDishId == storedTargetDishId) &&
        (proposalType != 'merge' ||
          (
            canonicalDishProposalResolutionEntityId(mergeTargetDishId) &&
            mergeTargetDishId != sourceDishId &&
            (
              !(
                proposalData.keys().hasAny(['sourceDishId']) &&
                proposalData.sourceDishId != null &&
                proposalData.keys().hasAny(['mergeTargetDishId']) &&
                proposalData.mergeTargetDishId != null &&
                storedTargetDishId != null
              ) || proposalData.mergeTargetDishId == storedTargetDishId
            )
          ));
    }

    function restaurantOperationLockAllowsMutation(restaurantId) {
      return !(restaurantId is string) ||
        restaurantId.size() == 0 ||
        restaurantId.matches('^.*/.*$') ||
        !exists(/databases/$(database)/documents/private_rating_restaurant_operation_locks/$(restaurantId));
    }

    function dishOperationLockAllowsMutation(dishId) {
      return !(dishId is string) ||
        dishId.size() == 0 ||
        dishId.matches('^.*/.*$') ||
        !exists(/databases/$(database)/documents/private_rating_dish_operation_locks/$(dishId));
    }

    function dataRestaurantOperationLockAllowsMutation(data) {
      return !data.keys().hasAny(['restaurantId']) ||
        restaurantOperationLockAllowsMutation(data.restaurantId);
    }

    function dataDishOperationLockAllowsMutation(data) {
      return !data.keys().hasAny(['dishId']) ||
        dishOperationLockAllowsMutation(data.dishId);
    }

    function dataDishAndRestaurantOperationLocksAllowMutation(data) {
      return dataDishOperationLockAllowsMutation(data) &&
        dataRestaurantOperationLockAllowsMutation(data);
    }

    function proposalOperationLocksAllowMutation(proposalData) {
      let sourceDishId = dishProposalSourceDishId(proposalData);
      let mergeTargetDishId = dishProposalMergeTargetDishId(proposalData);
      return dataRestaurantOperationLockAllowsMutation(proposalData) &&
        dishOperationLockAllowsMutation(sourceDishId) &&
        dishOperationLockAllowsMutation(mergeTargetDishId);
    }

    function canonicalExistingDishId(dishId) {
      return canonicalDishId(dishId) &&
        get(/databases/$(database)/documents/bitescore_dishes/$(dishId)).data.id == dishId;
    }

    function reviewDataHasCanonicalDishId(reviewData) {
      return reviewData.keys().hasAny(['dishId']) &&
        canonicalExistingDishId(reviewData.dishId);
    }

    function aggregateDataMatchesDishIdentity(dishId, aggregateData) {
      return aggregateData.keys().hasAny(['dishId']) &&
        aggregateData.dishId == dishId &&
        canonicalExistingDishId(dishId);
    }

    function validAggregateWriteGeneration(data) {
      return !data.keys().hasAny(['aggregateWriteGeneration']) ||
        (
          data.aggregateWriteGeneration is int &&
          data.aggregateWriteGeneration >= 0 &&
          data.aggregateWriteGeneration <= 9007199254740991
        );
    }

    function aggregateWriteGenerationOrZero(data) {
      return data.keys().hasAny(['aggregateWriteGeneration'])
        ? data.aggregateWriteGeneration
        : 0;
    }

    function aggregateWriteGenerationMatchesDish(dishId, aggregateData) {
      let dishData = get(/databases/$(database)/documents/bitescore_dishes/$(dishId)).data;
      return validAggregateWriteGeneration(dishData) &&
        validAggregateWriteGeneration(aggregateData) &&
        aggregateWriteGenerationOrZero(aggregateData) ==
          aggregateWriteGenerationOrZero(dishData);
    }

    function mergeLockBlocksClientReviews(dishId) {
      return canonicalDishId(dishId) &&
        exists(/databases/$(database)/documents/private_dish_merge_review_locks/$(dishId));
    }

    function reviewDataHasBlockingMergeLock(reviewData) {
      return reviewData.keys().hasAny(['dishId']) &&
        mergeLockBlocksClientReviews(reviewData.dishId);
    }

    function canonicalPrivateReviewMilestoneIdentity(value) {
      return value is string &&
        value.size() > 0 &&
        value.matches('^[^/\\s\\p{Cc}](?:[^/\\p{Cc}]*[^/\\s\\p{Cc}])?$') &&
        value != '.' &&
        value != '..' &&
        !value.matches('^__.*__$') &&
        value.toUtf8().size() <= 1500;
    }

    function strictReleasedReviewMilestoneLock(userId, lockData) {
      return lockData.keys().hasAll([
          'version',
          'userId',
          'operationId',
          'lockToken',
          'state',
          'createdAt',
          'updatedAt',
          'fingerprint'
        ]) &&
        lockData.keys().hasOnly([
          'version',
          'userId',
          'operationId',
          'lockToken',
          'state',
          'createdAt',
          'updatedAt',
          'fingerprint'
        ]) &&
        lockData.version == 'bitestar.review-milestone-lock.v1' &&
        lockData.userId == userId &&
        canonicalPrivateReviewMilestoneIdentity(lockData.userId) &&
        canonicalPrivateReviewMilestoneIdentity(lockData.operationId) &&
        lockData.lockToken is string &&
        lockData.lockToken.matches('^[0-9a-f]{64}$') &&
        lockData.state == 'released' &&
        lockData.createdAt is timestamp &&
        lockData.updatedAt is timestamp &&
        lockData.updatedAt >= lockData.createdAt &&
        lockData.fingerprint is string &&
        lockData.fingerprint.matches('^[0-9a-f]{64}$');
    }

    function reviewMilestoneLockAllowsClientMutation(userId) {
      let lockPath = /databases/$(database)/documents/private_review_milestone_reconciliation_locks/$(userId);
      return canonicalPrivateReviewMilestoneIdentity(userId) &&
        (
          !exists(lockPath) ||
          strictReleasedReviewMilestoneLock(userId, get(lockPath).data)
        );
    }

    function reviewDataUserAllowsMilestoneMutation(reviewData) {
      return reviewData.keys().hasAny(['userId']) &&
        reviewMilestoneLockAllowsClientMutation(reviewData.userId);
    }

    function mergeLockBlocksClientAggregates(dishId) {
      return canonicalDishId(dishId) &&
        exists(/databases/$(database)/documents/private_dish_merge_review_locks/$(dishId));
    }

    function aggregateDataHasBlockingMergeLock(aggregateData) {
      return aggregateData.keys().hasAny(['dishId']) &&
        mergeLockBlocksClientAggregates(aggregateData.dishId);
    }

    function createsOwnReview() {
      return emailVerified() && request.resource.data.userId == request.auth.uid;
    }

    function updatesOwnReview() {
      return emailVerified() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
    }

    function createsOwnReport(reportingField) {
      return emailVerified() &&
        request.resource.data[reportingField] == request.auth.uid &&
        request.resource.data.status == 'pending';
    }

    function readsOwnReport(reportingField) {
      return signedIn() && resource.data[reportingField] == request.auth.uid;
    }

    function updatesOwnReport(reportingField) {
      return emailVerified() &&
        resource.data[reportingField] == request.auth.uid &&
        request.resource.data[reportingField] == request.auth.uid &&
        changedKeys().hasOnly(['reason', 'message', 'note', 'updatedAt']);
    }

    function createsOwnDishEditProposal() {
      return emailVerified() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
    }

    function readsOwnDishEditProposal() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function createsOwnClaimRequest() {
      return emailVerified() &&
        request.resource.data.requesterUserId == request.auth.uid &&
        request.resource.data.status == 'pending';
    }

    function readsOwnClaimRequest() {
      return signedIn() && resource.data.requesterUserId == request.auth.uid;
    }

    function publicProfileWriteFields() {
      return [
        'userId',
        'publicDisplayName',
        'fallbackUsername',
        'username',
        'chosenUsername',
        'chosenUsernameNormalized',
        'createdAt',
        'updatedAt'
      ];
    }

    function canWriteOwnPublicReviewerProfile(userId) {
      return isSelf(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.keys().hasOnly(publicProfileWriteFields());
    }

    function canUpdateOwnPublicReviewerProfile(userId) {
      return isSelf(userId) &&
        resource.data.userId == userId &&
        request.resource.data.userId == userId &&
        changedKeys().hasOnly(publicProfileWriteFields());
    }

    function canAcknowledgeOwnLocalExpertBadgeCelebration(userId) {
      return isSelf(userId) &&
        changedKeys().hasOnly(['status', 'celebratedAt', 'updatedAt']) &&
        (
          !changedKeys().hasAny(['status']) ||
          request.resource.data.status == 'celebrated'
        );
    }

    function restaurantNameChangeRequestCreateFields() {
      return [
        'userId',
        'currentRestaurantName',
        'requestedRestaurantName',
        'status',
        'createdAt'
      ];
    }

    function canCreateOwnRestaurantNameChangeRequest() {
      return signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly(restaurantNameChangeRequestCreateFields());
    }

    match /restaurant_accounts/{restaurantUid} {
      allow get, list: if isAdmin() ||
        isSelf(restaurantUid) ||
        resource.data.approvalStatus == 'approved';
      allow create: if isAdmin() || canCreateOwnRestaurantAccount(restaurantUid);
      allow update: if isAdmin() || canUpdateOwnRestaurantAccount(restaurantUid);
      allow delete: if isAdmin();

      match /coupons/{couponId} {
        allow read: if isAdmin() ||
          isSelf(restaurantUid) ||
          isApprovedRestaurantAccount(restaurantUid);
        allow create, update: if canManageRestaurantContent(restaurantUid) &&
          request.resource.data.id == couponId;
        allow delete: if canManageRestaurantContent(restaurantUid);
      }

      match /daily_specials/{specialId} {
        allow read: if isAdmin() ||
          isSelf(restaurantUid) ||
          isApprovedRestaurantAccount(restaurantUid);
        allow create, update: if canManageRestaurantContent(restaurantUid) &&
          request.resource.data.id == specialId &&
          request.resource.data.restaurantId == restaurantUid &&
          request.resource.data.ownerUid == restaurantUid;
        allow delete: if canManageRestaurantContent(restaurantUid);
      }

      match /menu_images/{imageId} {
        allow read: if isAdmin() ||
          isSelf(restaurantUid) ||
          isApprovedRestaurantAccount(restaurantUid);
        allow create, update: if canManageRestaurantContent(restaurantUid) &&
          request.resource.data.id == imageId;
        allow delete: if canManageRestaurantContent(restaurantUid);
      }

      match /menu_items/{itemId} {
        allow read: if isAdmin() ||
          isSelf(restaurantUid) ||
          isApprovedRestaurantAccount(restaurantUid);
        allow create, update: if canManageRestaurantContent(restaurantUid) &&
          request.resource.data.id == itemId;
        allow delete: if canManageRestaurantContent(restaurantUid);
      }

      match /menu_sections/{sectionId} {
        allow read: if isAdmin() ||
          isSelf(restaurantUid) ||
          isApprovedRestaurantAccount(restaurantUid);
        allow create, update: if canManageRestaurantContent(restaurantUid) &&
          request.resource.data.id == sectionId;
        allow delete: if canManageRestaurantContent(restaurantUid);
      }

      match /coupon_number_reservations/{reservationId} {
        allow read, create, update, delete: if canManageRestaurantContent(restaurantUid);
      }

      match /coupon_code_reservations/{reservationId} {
        allow read, create, update, delete: if canManageRestaurantContent(restaurantUid);
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /restaurant_name_change_requests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if canCreateOwnRestaurantNameChangeRequest();
      allow update, delete: if isAdmin();
    }

    match /user_profiles/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create: if isAdmin() || canCreateOwnProfile(userId);
      allow update: if isAdmin() || canUpdateOwnProfile(userId);
      allow delete: if isAdmin();

      match /favorite_restaurants/{favoriteId} {
        allow read: if isAdmin() || isSelf(userId);
        allow create: if userOwnedCreate(userId);
        allow update: if userOwnedUpdate(userId);
        allow delete: if isAdmin() || isSelf(userId);
      }

      match /favorite_dishes/{favoriteId} {
        allow read: if isAdmin() || isSelf(userId);
        allow create: if userOwnedCreate(userId);
        allow update: if userOwnedUpdate(userId);
        allow delete: if isAdmin() || isSelf(userId);
      }

      match /favorite_coupons/{favoriteId} {
        allow read: if isAdmin() || isSelf(userId);
        allow create: if userOwnedCreate(userId);
        allow update: if userOwnedUpdate(userId);
        allow delete: if isAdmin() || isSelf(userId);
      }

      match /local_expert_badges/{badgeId} {
        allow read: if true;
        allow write: if false;
      }

      match /local_expert_badge_celebrations/{eventId} {
        allow read: if isAdmin() || isSelf(userId);
        allow create: if false;
        allow update: if canAcknowledgeOwnLocalExpertBadgeCelebration(userId);
        allow delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /customer_redemptions/{userId}/coupon_redemptions/{couponId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create, update: if isSelf(userId) &&
        request.resource.data.couponId == couponId;
      allow delete: if isAdmin() || isSelf(userId);
    }

    match /public_reviewer_profiles/{userId} {
      allow read: if true;
      allow create: if isAdmin() || canWriteOwnPublicReviewerProfile(userId);
      allow update: if isAdmin() || canUpdateOwnPublicReviewerProfile(userId);
      allow delete: if isAdmin();
    }

    match /public_usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /bitescore_restaurants/{restaurantId} {
      allow read: if true;
      allow create: if restaurantOperationLockAllowsMutation(restaurantId) &&
        validBiteScoreRestaurantCreateRevision() &&
        (
          isAdmin() ||
          canCreatePublicBiteScoreRestaurant(restaurantId)
        );
      allow update: if restaurantOperationLockAllowsMutation(restaurantId) &&
        validBiteScoreRestaurantUpdateRevision() &&
        (
          isAdmin() ||
          canOwnerUpdateBiteScoreRestaurant(restaurantId) ||
          canCompleteBiteScoreRestaurantProvenance()
        ) &&
        (
          biteScoreRestaurantProvenanceUnchanged() ||
          canCompleteBiteScoreRestaurantProvenance()
        );
      allow delete: if restaurantOperationLockAllowsMutation(restaurantId) &&
        isAdmin();
    }

    match /bitescore_dishes/{dishId} {
      allow read: if true;
      allow create: if canonicalDishId(dishId) &&
        dishOperationLockAllowsMutation(dishId) &&
        dataRestaurantOperationLockAllowsMutation(request.resource.data) &&
        request.resource.data.id == dishId &&
        aggregateWriteGenerationAbsentOnClientCreate() &&
        (
          isAdmin() ||
          (emailVerified() && validBiteScoreDishCreateProvenance())
        );
      allow update: if dishOperationLockAllowsMutation(dishId) &&
        dataRestaurantOperationLockAllowsMutation(resource.data) &&
        dataRestaurantOperationLockAllowsMutation(request.resource.data) &&
        (
          isAdmin() ||
          ownerOfBiteScoreRestaurant(resource.data.restaurantId) ||
          (
            emailVerified() &&
            changedKeys().hasOnly([
              'category',
              'subcategory',
              'categoryManualKeywords',
              'categoryTags',
              'imageCount',
              'primaryImageId',
              'primaryImageUrl',
              'updatedAt'
            ])
          )
        ) &&
        biteScoreDishProvenanceUnchanged() &&
        aggregateWriteGenerationUnchanged() &&
        validAggregateWriteGeneration(request.resource.data);
      allow delete: if dishOperationLockAllowsMutation(dishId) &&
        dataRestaurantOperationLockAllowsMutation(resource.data) &&
        isAdmin() &&
        validAggregateWriteGeneration(resource.data);
    }

    match /dish_catalog/{catalogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dish_rating_aggregates/{dishId} {
      allow read: if true;
      allow create: if (isAdmin() || emailVerified()) &&
        dishOperationLockAllowsMutation(dishId) &&
        dataDishAndRestaurantOperationLocksAllowMutation(request.resource.data) &&
        aggregateDataMatchesDishIdentity(dishId, request.resource.data) &&
        aggregateWriteGenerationMatchesDish(dishId, request.resource.data) &&
        !mergeLockBlocksClientAggregates(dishId) &&
        !aggregateDataHasBlockingMergeLock(request.resource.data);
      allow update: if (isAdmin() || emailVerified()) &&
        dishOperationLockAllowsMutation(dishId) &&
        dataDishAndRestaurantOperationLocksAllowMutation(resource.data) &&
        dataDishAndRestaurantOperationLocksAllowMutation(request.resource.data) &&
        aggregateDataMatchesDishIdentity(dishId, resource.data) &&
        aggregateDataMatchesDishIdentity(dishId, request.resource.data) &&
        aggregateWriteGenerationMatchesDish(dishId, request.resource.data) &&
        !mergeLockBlocksClientAggregates(dishId) &&
        !aggregateDataHasBlockingMergeLock(resource.data) &&
        !aggregateDataHasBlockingMergeLock(request.resource.data);
      allow delete: if isAdmin() &&
        dishOperationLockAllowsMutation(dishId) &&
        dataDishAndRestaurantOperationLocksAllowMutation(resource.data) &&
        aggregateDataMatchesDishIdentity(dishId, resource.data) &&
        aggregateWriteGenerationMatchesDish(dishId, resource.data) &&
        !mergeLockBlocksClientAggregates(dishId) &&
        !aggregateDataHasBlockingMergeLock(resource.data);
    }

    match /dish_reviews/{reviewId} {
      allow read: if true;
      allow create: if createsOwnReview() &&
        dataDishAndRestaurantOperationLocksAllowMutation(request.resource.data) &&
        reviewDataHasCanonicalDishId(request.resource.data) &&
        !reviewDataHasBlockingMergeLock(request.resource.data) &&
        reviewDataUserAllowsMilestoneMutation(request.resource.data);
      allow update: if (isAdmin() || updatesOwnReview()) &&
        dataDishAndRestaurantOperationLocksAllowMutation(resource.data) &&
        dataDishAndRestaurantOperationLocksAllowMutation(request.resource.data) &&
        reviewDataHasCanonicalDishId(resource.data) &&
        reviewDataHasCanonicalDishId(request.resource.data) &&
        !reviewDataHasBlockingMergeLock(resource.data) &&
        !reviewDataHasBlockingMergeLock(request.resource.data) &&
        reviewDataUserAllowsMilestoneMutation(resource.data) &&
        reviewDataUserAllowsMilestoneMutation(request.resource.data);
      allow delete: if (isAdmin() || (signedIn() && resource.data.userId == request.auth.uid)) &&
        dataDishAndRestaurantOperationLocksAllowMutation(resource.data) &&
        reviewDataHasCanonicalDishId(resource.data) &&
        !reviewDataHasBlockingMergeLock(resource.data) &&
        reviewDataUserAllowsMilestoneMutation(resource.data);
    }

    match /bitescore_dish_images/{imageId} {
      allow read: if true;
      allow create: if isAdmin() ||
        (emailVerified() && request.resource.data.uploadedByUserId == request.auth.uid);
      allow update: if isAdmin() ||
        ownerOfBiteScoreRestaurant(resource.data.restaurantId) ||
        (
          emailVerified() &&
          changedKeys().hasOnly([
            'helpfulCount',
            'notHelpfulCount',
            'primary',
            'sortOrder',
            'updatedAt'
          ])
        );
      allow delete: if isAdmin() ||
        (signedIn() && resource.data.uploadedByUserId == request.auth.uid);
    }

    match /bitescore_dish_image_votes/{voteId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if emailVerified() && request.resource.data.userId == request.auth.uid;
      allow update: if emailVerified() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /review_feedback_votes/{voteId} {
      allow read: if true;
      allow create: if emailVerified() &&
        request.resource.data.userId == request.auth.uid &&
        dataDishAndRestaurantOperationLocksAllowMutation(request.resource.data);
      allow update: if emailVerified() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        dataDishAndRestaurantOperationLocksAllowMutation(resource.data) &&
        dataDishAndRestaurantOperationLocksAllowMutation(request.resource.data);
      allow delete: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        dataDishAndRestaurantOperationLocksAllowMutation(resource.data);
    }

    match /review_reports/{reportId} {
      allow read: if isAdmin() || readsOwnReport('reportingUserId');
      allow create: if createsOwnReport('reportingUserId') &&
        dataDishAndRestaurantOperationLocksAllowMutation(request.resource.data);
      allow update: if (isAdmin() || updatesOwnReport('reportingUserId')) &&
        dataDishAndRestaurantOperationLocksAllowMutation(resource.data) &&
        dataDishAndRestaurantOperationLocksAllowMutation(request.resource.data);
      allow delete: if isAdmin() &&
        dataDishAndRestaurantOperationLocksAllowMutation(resource.data);
    }

    match /restaurant_reports/{reportId} {
      allow read: if isAdmin() || readsOwnReport('reportingUserId');
      allow create: if createsOwnReport('reportingUserId') &&
        dataRestaurantOperationLockAllowsMutation(request.resource.data);
      allow update: if (isAdmin() || updatesOwnReport('reportingUserId')) &&
        dataRestaurantOperationLockAllowsMutation(resource.data) &&
        dataRestaurantOperationLockAllowsMutation(request.resource.data);
      allow delete: if isAdmin() &&
        dataRestaurantOperationLockAllowsMutation(resource.data);
    }

    match /dish_reports/{reportId} {
      allow read: if isAdmin() || readsOwnReport('reportingUserId');
      allow create: if createsOwnReport('reportingUserId') &&
        dataDishAndRestaurantOperationLocksAllowMutation(request.resource.data);
      allow update: if (isAdmin() || updatesOwnReport('reportingUserId')) &&
        dataDishAndRestaurantOperationLocksAllowMutation(resource.data) &&
        dataDishAndRestaurantOperationLocksAllowMutation(request.resource.data);
      allow delete: if isAdmin() &&
        dataDishAndRestaurantOperationLocksAllowMutation(resource.data);
    }

    match /duplicate_restaurant_reports/{reportId} {
      allow read: if isAdmin() || readsOwnReport('reportingUserId');
      allow create: if createsOwnReport('reportingUserId') &&
        dataRestaurantOperationLockAllowsMutation(request.resource.data);
      allow update: if (isAdmin() || updatesOwnReport('reportingUserId')) &&
        dataRestaurantOperationLockAllowsMutation(resource.data) &&
        dataRestaurantOperationLockAllowsMutation(request.resource.data);
      allow delete: if isAdmin() &&
        dataRestaurantOperationLockAllowsMutation(resource.data);
    }

    match /dish_edit_proposals/{proposalId} {
      allow read: if isAdmin() || readsOwnDishEditProposal();
      allow create: if createsOwnDishEditProposal() &&
        dishProposalResolutionIdentitiesValid(request.resource.data) &&
        proposalOperationLocksAllowMutation(request.resource.data);
      allow update: if isAdmin() &&
        dishProposalResolutionIdentitiesValid(request.resource.data) &&
        proposalOperationLocksAllowMutation(resource.data) &&
        proposalOperationLocksAllowMutation(request.resource.data);
      allow delete: if isAdmin() &&
        proposalOperationLocksAllowMutation(resource.data);
    }

    match /restaurant_claim_requests/{requestId} {
      allow read: if isAdmin() || readsOwnClaimRequest();
      allow create: if createsOwnClaimRequest() &&
        dataRestaurantOperationLockAllowsMutation(request.resource.data);
      allow update: if isAdmin() &&
        dataRestaurantOperationLockAllowsMutation(resource.data) &&
        dataRestaurantOperationLockAllowsMutation(request.resource.data);
      allow delete: if isAdmin() &&
        dataRestaurantOperationLockAllowsMutation(resource.data);
    }

    match /bitesaver_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.status == 'open' &&
        (!('reporterUid' in request.resource.data) ||
          (signedIn() && request.resource.data.reporterUid == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    match /restaurant_menus/{menuId} {
      allow read: if true;
      allow create: if isAdmin() ||
        (
          emailVerified() &&
          request.resource.data.createdByUserId == request.auth.uid &&
          request.resource.data.bitescoreRestaurantId is string &&
          ownerOfBiteScoreRestaurant(request.resource.data.bitescoreRestaurantId)
        );
      allow update: if isAdmin() || ownsSharedRestaurantMenu(menuId);
      allow delete: if isAdmin();

      match /menu_images/{imageId} {
        allow read: if true;
        allow create, update: if isAdmin() || ownsSharedRestaurantMenu(menuId);
        allow delete: if isAdmin() || ownsSharedRestaurantMenu(menuId);
      }

      match /menu_items/{itemId} {
        allow read: if true;
        allow create, update: if isAdmin() || ownsSharedRestaurantMenu(menuId);
        allow delete: if isAdmin() || ownsSharedRestaurantMenu(menuId);
      }

      match /menu_sections/{sectionId} {
        allow read: if true;
        allow create, update: if isAdmin() || ownsSharedRestaurantMenu(menuId);
        allow delete: if isAdmin() || ownsSharedRestaurantMenu(menuId);
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /restaurant_invites/{inviteId} {
      allow read, write: if false;
    }

    match /private_dish_merge_review_locks/{dishId} {
      allow read, write: if false;
    }

    match /private_rating_destructive_jobs/{jobId} {
      allow read, write: if false;
    }

    match /private_rating_destructive_job_items/{document=**} {
      allow read, write: if false;
    }

    match /private_rating_restaurant_operation_locks/{restaurantId} {
      allow read, write: if false;
    }

    match /private_rating_dish_operation_locks/{dishId} {
      allow read, write: if false;
    }

    match /private_review_milestone_reconciliation_locks/{userId} {
      allow read, write: if false;
    }

    match /private_review_milestone_reconciliation_terminal_states/{userId} {
      allow read, write: if false;
    }

    match /bitescore_contribution_point_ledger/{entryId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /proximity_push_requests/{requestId} {
      allow read, write: if false;
    }

    match /customer_device_installations/{installationId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
