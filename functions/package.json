{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "validate:deployment": "node scripts/validate_deployment_env.js validate .env.coupon-app-29446",
    "predeploy:safe": "npm run build && npm run validate:deployment",
    "test": "npm run build && node --test test/*.test.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:postgis-hosted": "npm run build && node --test test/postgis_execution_approval.test.cjs test/postgis_cloudsql.test.cjs test/postgis_hosted_transport.test.cjs test/postgis_hosted_entrypoint.test.cjs"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "1.12.1",
    "@googleapis/playintegrity": "28.0.0",
    "@peculiar/x509": "1.14.0",
    "cbor-x": "1.6.6",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "geofire-common": "^6.0.0",
    "google-auth-library": "10.6.2",
    "pg": "8.16.3",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1",
    "typescript": "^5.7.3"
  },
  "private": true
}
